erDiagram
    USER {
        int user_id PK
        string username
        string password_hash
        boolean is_artist
        datetime created_at
        datetime last_login
    }

    PRODUCTION_HOUSE {
        int production_house_id PK
        string name
        string type
    }

    ARTIST {
        int artist_id PK
        string name
        string country
        boolean is_band
        int n_of_listeners
        jsonb band_member_ids
        string country_of_origin
        int production_house_id FK
        datetime created_at
    }


    SONG {
        int song_id PK
        string song_name
        int duration
        date publish_date
        json genres
        int listen_count
        boolean is_published
    }

    LYRICS {
        int lyrics_id PK
        int song_id FK
        text lyrics_text
        string lyrics_filename
    }

    PLAYLIST {
        int playlist_id PK
        string name
        int created_by_user_id FK
        string cover_art_url
        int duration
        string release_type
        datetime last_updated
    }

    LISTENING_ACTIVITY {
        int activity_id PK
        int user_id FK
        int song_id FK
        int listening_time
        datetime timestamp
    }

    SONG_ARTIST_RELATIONSHIP {
        int song_id FK
        int artist_id FK
        string role
        boolean is_primary
    }

    PLAYLIST_SONG {
        int playlist_id FK
        int song_id FK
        int order
    }

    USER ||--o{ PLAYLIST : "creates (1:N)"
    PRODUCTION_HOUSE ||--o{ ARTIST : "manages (1:N)"
    ARTIST ||--o{ SONG_ARTIST_RELATIONSHIP : "performs (M:N)"
    SONG ||--o{ SONG_ARTIST_RELATIONSHIP : "has_artist (M:N)"
    SONG ||--o{ LYRICS : "has (1:1)"
    PLAYLIST ||--o{ PLAYLIST_SONG : "contains (M:N)"
    SONG ||--o{ PLAYLIST_SONG : "belongs_to (M:N)"
    USER ||--o{ LISTENING_ACTIVITY : "records (1:N)"
    SONG ||--o{ LISTENING_ACTIVITY : "logged_in (1:N)"